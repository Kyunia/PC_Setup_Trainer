{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/replay.html",
      "destination": "/replay",
      "permanent": true
    },
    {
      "source": "/setup_test.html",
      "destination": "/setup_test",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/replay",
      "destination": "/replay.html"
    },
    {
      "source": "/replay/:id",
      "destination": "/replay.html"
    },
    {
      "source": "/setup_test",
      "destination": "/setup_test.html"
    }
  ]
}
